# Salin file ini menjadi .env.local lalu isi nilainya dari Supabase.
# Supabase Dashboard → Project Settings → API

# Project URL (contoh: https://abcxyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon public key (aman dipakai di browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — RAHASIA, hanya dipakai di server, jangan diekspos ke client
SUPABASE_SERVICE_ROLE_KEY=

# (Opsional) Batasi siapa yang boleh masuk admin, pisah dengan koma.
# Kosongkan = semua akun Google/email yang login boleh masuk admin.
# Contoh: ADMIN_EMAILS=kamu@gmail.com,rekan@gmail.com
ADMIN_EMAILS=
